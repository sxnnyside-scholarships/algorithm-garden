# Algorithm Garden — Environment Configuration (Placeholder values only)

# API Server
PORT=8080
HOST=127.0.0.1
APP_ENV=development
CORS_ORIGIN=http://127.0.0.1:5173

# Database (sqlite default; postgres optional via DATABASE_URL)
DB_DRIVER=sqlite
SQLITE_PATH=./data/algorithm_garden.sqlite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/algorithm_garden

# Authentication & Security (Required >= 32 random bytes when APP_ENV=production)
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes-in-production
TOKEN_TTL_SECONDS=86400
PBKDF2_ITERATIONS=120000

# Runner / Sandbox Orchestration
RUNNER_MODE=docker
RUNNER_IMAGE=algorithm-garden-runner:0.1.0
RUNNER_TIMEOUT_MS=5000
RUNNER_MEMORY_LIMIT=256m
RUNNER_CPU_LIMIT=1.0
RUNNER_PIDS_LIMIT=64
RUNNER_MAX_EVENTS=50000
RUNNER_MAX_STDOUT_BYTES=2097152
RUNNER_POOL_SIZE=2

# Web Frontend & Reverse Proxy
VITE_API_BASE_URL=http://127.0.0.1:8080
API_UPSTREAM=http://api:8080
STATIC_DIR=
DOCKER_GID=0
